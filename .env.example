# Copy to .env when you want a model. The app runs without this file.
# The default scorer is a local heuristic and does not call a provider.

# local | mock | openai | anthropic | google | openai-compatible
AI_PROVIDER=local

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Google AI
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.7-flash

# OpenAI-compatible local server (Ollama, LM Studio, vLLM, and similar).
# Example base URL: http://127.0.0.1:11434/v1
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# SQLite file by default. For Postgres later, see docs/design.md.
DATABASE_URL=file:./data/keel.sqlite

# v1 has no sign-in. Every row is stored for this user id.
LOCAL_USER_ID=local
LOCAL_USER_NAME=Local user

# Dev server port. `npm run dev` uses 4317.
PORT=4317
